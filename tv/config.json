{
  "platform": "tv",
  "store_name": "Zflyx App Store",
  "version": "1.0.0",
  "ui": {
    "layout": "grid",
    "columns": 4,
    "rows": 3,
    "tile_size": "large",
    "show_banners": true,
    "show_hero": true,
    "show_ratings": true,
    "show_downloads": false,
    "show_categories": true,
    "show_search": true,
    "animation_speed": "normal",
    "transition_effect": "fade",
    "focus_scale": 1.1,
    "focus_glow": true
  },
  "navigation": {
    "remote_supported": true,
    "gamepad_supported": true,
    "voice_search": false,
    "keyboard_supported": false,
    "scroll_speed": "medium"
  },
  "download": {
    "default_storage": "internal",
    "allow_external": true,
    "max_parallel": 1,
    "show_progress": true,
    "show_notification": true,
    "auto_install": false,
    "delete_after_install": false
  },
  "updates": {
    "check_interval": "daily",
    "auto_download": false,
    "notify_on_update": true,
    "install_on_complete": false,
    "ignore_beta": true
  },
  "theme": {
    "primary_color": "#6C3CE1",
    "secondary_color": "#E83E8C",
    "background_color": "#0A0A1A",
    "card_color": "#1A1A2E",
    "card_hover_color": "#2A2A4E",
    "accent_color": "#00D4FF",
    "text_color": "#FFFFFF",
    "text_secondary": "#AAAAAA",
    "text_muted": "#666666",
    "status_bar_color": "#0A0A1A",
    "navigation_bar_color": "#0A0A1A"
  },
  "features": {
    "dark_mode": true,
    "night_mode": false,
    "parental_controls": false,
    "download_queue": true,
    "favorites": false,
    "recently_updated": true,
    "top_downloads": true
  },
  "content": {
    "max_apps_per_page": 20,
    "cache_icons": true,
    "cache_duration": 3600,
    "refresh_interval": 300
  }
}
